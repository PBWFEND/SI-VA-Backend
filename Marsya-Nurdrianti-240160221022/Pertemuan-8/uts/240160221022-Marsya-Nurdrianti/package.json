{
  "name": "uts-backend-absensi-mahasiswa",
  "version": "1.0.0",
  "description": "REST API Sistem Informasi Absensi Mahasiswa untuk UTS Mini Project Backend menggunakan Express.js 5, TypeScript, Prisma ORM, dan SQLite",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --experimental-strip-types test-api.ts"
  },
  "keywords": [
    "express",
    "prisma",
    "sqlite",
    "rest-api",
    "absensi-mahasiswa",
    "uts"
  ],
  "author": "Marsya Nurdrianti",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}

