{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "app.ts",
    "server.ts",
    "client.ts",
    "test.ts",
    "prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "generated"
  ]
}

