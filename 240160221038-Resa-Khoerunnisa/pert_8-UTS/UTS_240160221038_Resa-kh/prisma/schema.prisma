
generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Menu {
  id        Int     @id @default(autoincrement())
  nama      String
  kategori  String
  harga     Int
  stok      Int     @default(0)
  tersedia  Boolean @default(true)

  @@map("menu")
}
