generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Pengguna {
  id    Int    @id @default(autoincrement())
  nim   String @unique
  nama  String
  email String
  role  String

  @@map("pengguna")
}

model Buku {
  id      Int    @id @default(autoincrement())
  judul   String
  penulis String
  tahun   Int
  stok    Int    @default(0)

  @@map("buku")
}