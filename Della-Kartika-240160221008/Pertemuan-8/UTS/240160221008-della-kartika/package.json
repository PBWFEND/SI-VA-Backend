{
  "name": "absensi-della-kartika",
  "version": "1.0.0",
  "description": "Sistem Informasi Absensi Mahasiswa — REST API UTS Mini Project Backend menggunakan Express.js, TypeScript, dan Prisma ORM",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "dev": "node --watch --experimental-strip-types server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node --experimental-strip-types prisma/seed.ts",
    "test": "node --experimental-strip-types test.ts"
  },
  "keywords": [
    "express",
    "prisma",
    "sqlite",
    "rest-api",
    "absensi",
    "mahasiswa",
    "uts"
  ],
  "author": "Della Kartika",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}
