generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Pengguna {
  id           Int      @id @default(autoincrement())
  nim          String   @unique
  nama         String
  email        String   @unique
  passwordHash String
  role         String   @default("MAHASISWA") // ADMIN, DOSEN, STAF, MAHASISWA
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pengguna")
}

model Mahasiswa {
  id        Int      @id @default(autoincrement())
  nim       String   @unique
  nama      String
  prodi     String
  angkatan  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mahasiswa")
}
