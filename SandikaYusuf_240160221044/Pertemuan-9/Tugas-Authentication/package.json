{
  "name": "auth-mahasiswa-sandika",
  "version": "1.0.0",
  "description": "Layanan Autentikasi dan Manajemen Data Mahasiswa — Pertemuan 9 Backend Web Framework",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "dev": "node --watch --experimental-strip-types server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --experimental-strip-types test.ts"
  },
  "keywords": [
    "express",
    "prisma",
    "sqlite",
    "scrypt",
    "authentication",
    "mahasiswa"
  ],
  "author": "Sandika Yusuf Permana",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}

